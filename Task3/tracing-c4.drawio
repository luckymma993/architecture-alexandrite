 в запросах)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#D64545;" vertex="1" parent="1"><mxGeometry x="80" y="1370" width="400" height="60" as="geometry" /></mxCell><mxCell id="tr-shop" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;exitX=1;exitY=0.83;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.83;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;strokeColor=#D64545;strokeWidth=2;fontColor=#D64545;" edge="1" parent="1" source="6bDfexBDMjg7O7AECw8N-8" target="tr-col"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1370" y="380" /><mxPoint x="1370" y="1350" /><mxPoint x="1100" y="1350" /></Array></mxGeometry></mxCell><mxCell id="tr-shop-l" value="Спаны [OTLP/gRPC]" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;" vertex="1" connectable="0" parent="tr-shop"><mxGeometry x="0.55" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell><mxCell id="tr-crm" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;exitX=1;exitY=0.83;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;strokeColor=#D64545;strokeWidth=2;fontColor=#D64545;" edge="1" parent="1" source="6bDfexBDMjg7O7AECw8N-10" target="tr-col"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1355" y="650" /><mxPoint x="1355" y="1335" /><mxPoint x="1020" y="1335" /></Array></mxGeometry></mxCell><mxCell id="tr-mes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;exitX=1;exitY=0.83;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;strokeColor=#D64545;strokeWidth=2;fontColor=#D64545;" edge="1" parent="1" source="6bDfexBDMjg7O7AECw8N-1" target="tr-col"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="860" y="990" /><mxPoint x="860" y="1440" /></Array></mxGeometry></mxCell><mxCell id="tr-mes-l" value="Спаны&lt;br&gt;[OTLP/gRPC]" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;" vertex="1" connectable="0" parent="tr-mes"><mxGeometry x="0.3" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell><mxCell id="pr-legend" value="Где заказ теряется или зависает&lt;br&gt;1. MES API: расчёт цены 2–30 минут занимает поток, заказ «висит» в SUBMITTED&lt;br&gt;2. RabbitMQ: сообщение о новом заказе от API user не дошло до CRM, нет DLX и подтверждений&lt;br&gt;3. CRM API: ошибка обработки сообщения о смене статуса, статус в Shop DB не обновлён&lt;br&gt;4. Вход API user: поток заказов без ограничений перегружает MES API&lt;br&gt;5. MES: медленный список заказов, оператор поздно берёт заказ в работу&lt;br&gt;6. Shop API → 3d files storage: файл модели не загрузился, MES не может рассчитать цену" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#D64545;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1780" y="820" width="600" height="170" as="geometry" /></mxCell><mxCell id="pr-1" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D64545;strokeColor=#A32D2D;fontColor=#FFFFFF;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="780" y="860" width="30" height="30" as="geometry" /></mxCell><mxCell id="pr-2" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D64545;strokeColor=#A32D2D;fontColor=#FFFFFF;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1690" y="600" width="30" height="30" as="geometry" /></mxCell><mxCell id="pr-3" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D64545;strokeColor=#A32D2D;fontColor=#FFFFFF;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1340" y="600" width="30" height="30" as="geometry" /></mxCell><mxCell id="pr-4" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D64545;strokeColor=#A32D2D;fontColor=#FFFFFF;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="480" y="870" width="30" height="30" as="geometry" /></mxCell><mxCell id="pr-5" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D64545;strokeColor=#A32D2D;fontColor=#FFFFFF;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="780" y="1050" width="30" height="30" as="geometry" /></mxCell><mxCell id="pr-6" value="6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D64545;strokeColor=#A32D2D;fontColor=#FFFFFF;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="870" y="420" width="30" height="30" as="geometry" /></mxCell><mxCell id="lg-t" value="&lt;b&gt;Легенда&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="80" y="1600" width="300" height="25" as="geometry" /></mxCell><mxCell id="lg-0" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D64545;strokeColor=#A32D2D;" vertex="1" parent="1"><mxGeometry x="80" y="1635" width="40" height="25" as="geometry" /></mxCell><mxCell id="lg-0-t" value="Новые элементы для трейсинга" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="130" y="1637" width="450" height="25" as="geometry" /></mxCell><mxCell id="lg-1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;strokeColor=#0E7DAD;" vertex="1" parent="1"><mxGeometry x="80" y="1675" width="40" height="25" as="geometry" /></mxCell><mxCell id="lg-1-t" value="Существующие элементы" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="130" y="1677" width="450" height="25" as="geometry" /></mxCell></root>
